# ====================================================================
# PAPIDO ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================

# Application
PORT=5000
NODE_ENV=production
APP_NAME=Papido-Backend
CLIENT_URL=https://www.papido.online

# Database Settings (TiDB Cloud MySQL)
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username
DB_PASSWORD=your_tidb_secure_password
DB_NAME=papido_db
DB_SSL=true
DB_CONNECTION_LIMIT=20

# Authentication & JWT Secrets (Must be at least 32 high-entropy characters)
JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=generate_with_openssl_rand_hex_32
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Map & Location Providers (Supports 'osm', 'google', 'mapbox')
MAP_PROVIDER=osm
MAP_API_KEY=your_map_api_key

# Payment Gateway (Supports 'mock', 'razorpay', 'cash')
PAYMENT_GATEWAY=mock
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_API_SECRET=your_payment_api_secret

# Push Notification Settings (Firebase FCM / Web Push)
PUSH_NOTIFICATION_KEY=your_fcm_server_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@papido.online

# Email SMTP Settings (For transactional OTPs & ride receipts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_service_account@gmail.com
SMTP_PASS=your_gmail_app_password_16_chars
SMTP_FROM="Papido" <no-reply@papido.online>

# Redis Settings (Optional: for horizontal multi-instance Socket.IO clustering)
# Leave empty for single-instance in-memory WebSocket mode
REDIS_URL=

# Storage Settings (Optional: 'r2', 's3', or 'local' - defaults to 'local')
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=papido-uploads
R2_PUBLIC_URL=https://uploads.papido.online
