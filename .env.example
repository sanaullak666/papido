# ====================================================================
# PAPIDO ENVIRONMENT CONFIGURATION
# ====================================================================

# Application
PORT=5000
NODE_ENV=development
APP_NAME=Papido-Backend
CLIENT_URL=http://localhost:5173

# Database Settings (MySQL primary, auto-fallback SQLite for zero-setup local dev)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=papido_db
DB_CONNECTION_LIMIT=10

# Authentication & JWT Secrets
JWT_SECRET=papido_super_secure_jwt_secret_key_2026_production_ready_xyz987
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=papido_super_secure_refresh_token_secret_2026_abc123
JWT_REFRESH_EXPIRES_IN=30d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Map & Location Providers (Supports 'mock', 'osm', 'google', 'mapbox')
MAP_PROVIDER=osm
MAP_API_KEY=mock_map_api_key_sample

# Payment Gateway (Supports 'mock', 'razorpay', 'stripe', 'cash')
PAYMENT_GATEWAY=mock
PAYMENT_API_KEY=mock_payment_api_key_sample
PAYMENT_API_SECRET=mock_payment_api_secret_sample

# Push Notification Settings
PUSH_NOTIFICATION_KEY=mock_fcm_notification_key
