{
  "name": "papido-backend",
  "version": "1.0.0",
  "description": "Production-Ready Backend API for Papido Ride-Hailing Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:cluster": "pm2 start ecosystem.config.js",
    "stop:cluster": "pm2 stop ecosystem.config.js",
    "status:cluster": "pm2 status",
    "dev": "nodemon src/server.js",
    "test": "node tests/run-tests.js",
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "db:clean": "node ../database/clean_db.js"
  },
  "keywords": [
    "papido",
    "ride-hailing",
    "express",
    "socket.io",
    "mysql",
    "jwt",
    "clean-architecture"
  ],
  "author": "Papido Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.0.13",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
